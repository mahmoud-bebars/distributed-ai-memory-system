name = "distributed-ai-memory-system"
main = "src/index.ts"
compatibility_date = "2026-08-01"
compatibility_flags = ["nodejs_compat"]

# Uncomment once DNS is pointed at this Worker. The second route is only
# needed if you're using SHARE_HOSTNAME below to carve out a separate,
# access-control-bypassed domain for share links — otherwise one is enough.
routes = [
  { pattern = "memory.example.com", custom_domain = true },
  # { pattern = "share.example.com", custom_domain = true },
]

[[d1_databases]]
binding = "DAMS_DB"
database_name = "dams_db"
database_id = "<YOUR_D1_DATABASE_ID>"          # wrangler d1 info dams_db

[[r2_buckets]]
binding = "DAMS_BUCKET"
bucket_name = "dmas"

# --- Optional: hybrid semantic + keyword search --------------------------
# The semantic half (Workers AI embeddings + Vectorize) is optional. Without
# it, search falls back to keyword-only (D1 FTS5) and nothing that writes
# memory ever depends on it. To use it, create the Vectorize index once
# (bge-m3 is 1024-dimensional — the dimensions must match), then deploy:
#
#   wrangler vectorize create dams-memory --dimensions=1024 --metric=cosine
#   wrangler vectorize create-metadata-index dams-memory --property-name=projectSlug --type=string
#
# `wrangler deploy` fails if a [[vectorize]] binding points at an index that
# doesn't exist yet. To go keyword-only, delete the marked block below — or,
# in CI, set WRANGLER_DISABLE_SEMANTIC_SEARCH=1 and
# server/scripts/render-wrangler-toml.sh strips it for you. Workers Free
# plan is enough (see README's free-plan notes).
# >>> semantic-search
[ai]
binding = "AI"

[[vectorize]]
binding = "VECTORIZE"
index_name = "dams-memory"
# <<< semantic-search

# Workflows need no external resources, so they stay even when
# semantic search is disabled (they fall back to inline execution if unbound).
[[workflows]]
name = "dams-search-backfill"
binding = "SEARCH_WORKFLOW"
class_name = "SearchBackfillWorkflow"

# Executes an approved action plan, one step per action.
[[workflows]]
name = "dams-actions"
binding = "ACTIONS_WORKFLOW"
class_name = "ActionsWorkflow"

# Retries entries whose embedding was paused (daily Workers AI budget) or failed.
[triggers]
crons = ["*/15 * * * *"]

[assets]
directory = "../client/dist"
binding = "ASSETS"
# Needed for /share/:token — it's a client-side-only route (no matching
# static file), so a direct page load must fall back to index.html and let
# main.tsx's own path check render ShareView.
not_found_handling = "single-page-application"

[vars]
# Gates the session cookie's Secure attribute (modules/tokens/routes.ts) —
# keep this "production" in the deployed config; local `wrangler dev`
# overrides it back to "development" via .dev.vars (which takes precedence
# over [vars]), since browsers reject Secure cookies over plain http.
ENVIRONMENT = "production"
# Optional free-tier budget guards (defaults in src/lib/budget.ts). Every
# Anthropic call checks both first and logs its usage to D1.
# LLM_DAILY_TOKEN_CAP = "500000"         # Anthropic tokens per UTC day
# LLM_TASK_TOKEN_CAP = "100000"          # Anthropic tokens per chat turn / task
# WORKERS_AI_DAILY_TOKEN_CAP = "5000000" # estimated embedding tokens per UTC day
# Optional. Set this only if you want a second hostname (e.g. share.example.com,
# uncommented in `routes` above) left outside whatever access control you put
# in front of memory.example.com, so share-link recipients and /mcp clients
# can still be reached. See CLAUDE.md's "Shareable read-only links" section.
# Leave unset (or delete this line) if you don't need that — share links then
# just resolve on whatever host served the request.
# SHARE_HOSTNAME = "share.example.com"

# Secrets — set each with `wrangler secret put <NAME>` (and mirror them in a
# local, git-ignored .dev.vars for `wrangler dev`):
#   wrangler secret put ANTHROPIC_API_KEY   # existing — chat-with-memory
#   wrangler secret put DAMS_ADMIN_TOKEN    # break-glass bootstrap credential for
#                                            # the token auth layer (see
#                                            # src/modules/tokens) — log into the
#                                            # web UI with it once to create your
#                                            # first real token, then prefer that.
