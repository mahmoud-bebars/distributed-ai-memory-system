name = "distributed-ai-memory-system"
main = "src/index.ts"
compatibility_date = "2026-08-01"
compatibility_flags = ["nodejs_compat"]

# Uncomment once DNS is pointed at this Worker. The second route is only
# needed if you're using SHARE_HOSTNAME below to carve out a separate,
# access-control-bypassed domain for share links — otherwise one is enough.
routes = [
  { pattern = "memory.example.com", custom_domain = true },
  # { pattern = "share.example.com", custom_domain = true },
]

[[d1_databases]]
binding = "DAMS_DB"
database_name = "dams_db"
database_id = "<YOUR_D1_DATABASE_ID>"          # wrangler d1 info dams_db

[[r2_buckets]]
binding = "DAMS_BUCKET"
bucket_name = "dmas"

[assets]
directory = "../client/dist"
binding = "ASSETS"
# Needed for /share/:token — it's a client-side-only route (no matching
# static file), so a direct page load must fall back to index.html and let
# main.tsx's own path check render ShareView.
not_found_handling = "single-page-application"

[vars]
ENVIRONMENT = "development"
# Optional. Set this only if you want a second hostname (e.g. share.example.com,
# uncommented in `routes` above) left outside whatever access control you put
# in front of memory.example.com, so share-link recipients and /mcp clients
# can still be reached. See CLAUDE.md's "Shareable read-only links" section.
# Leave unset (or delete this line) if you don't need that — share links then
# just resolve on whatever host served the request.
# SHARE_HOSTNAME = "share.example.com"

# Secrets — set each with `wrangler secret put <NAME>` (and mirror them in a
# local, git-ignored .dev.vars for `wrangler dev`):
#   wrangler secret put ANTHROPIC_API_KEY   # existing — chat-with-memory
#   wrangler secret put DAMS_ADMIN_TOKEN    # break-glass bootstrap credential for
#                                            # the token auth layer (see
#                                            # src/modules/tokens) — log into the
#                                            # web UI with it once to create your
#                                            # first real token, then prefer that.
