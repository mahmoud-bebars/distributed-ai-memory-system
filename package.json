{
  "name": "distributed-ai-memory-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "deploy": "npm run build --workspace=client && npm run deploy --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate:local": "npm run db:migrate:local --workspace=server",
    "db:migrate:remote": "npm run db:migrate:remote --workspace=server",
    "typecheck": "npm run typecheck --workspace=server"
  }
}
